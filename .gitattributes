# Store text files with LF in the repository and check them out with LF on every OS.
# The code runs in Linux containers, where CRLF breaks shell scripts and Dockerfiles.
* text=auto eol=lf

# Language-aware diff hunk headers (shows the enclosing function or heading).
*.py    text diff=python
*.pyi   text diff=python
*.md    text diff=markdown
*.html  text diff=html
*.css   text diff=css
*.sh    text diff=bash

# Binary files: never normalize line endings, never diff as text.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.parquet binary
*.gz      binary
*.zip     binary

# Generated by uv: collapsed in GitHub pull request diffs.
uv.lock linguist-generated=true
