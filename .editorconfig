# EditorConfig — https://editorconfig.org
# Keeps whitespace consistent across editors. Line endings are also enforced by .gitattributes.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,jinja,j2,css,js}]
indent_size = 2

[*.md]
# List continuation lines align with the text after the marker ("1. " is 3 characters),
# so Markdown indentation is not a multiple of any fixed size.
indent_size = unset
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
